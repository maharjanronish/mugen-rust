<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MUGEN content lives in a user-visible folder (like Ikemen GO).
         Android 8/9: classic storage permission. Android 10: legacy storage
         via requestLegacyExternalStorage below. Android 11+: the "All files
         access" toggle (MANAGE_EXTERNAL_STORAGE) for this sideloaded APK. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="Kurogane"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/KuroganeTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
